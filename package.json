{
  "name": "foreman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "foreman": "src/cli/main.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit && node --test 'test/**/*.test.ts'",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  }
}
